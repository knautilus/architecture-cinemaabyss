{
  "ReverseProxy": {
    "Routes": {
      "movies": {
        "ClusterId": "moviesservice",
        "Order": 1,
        "Match": {
          "Path": "/api/movies/{**catch-all}"
        }
      },
      "monolith": {
        "ClusterId": "monolith",
        "Order": 2,
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "moviesservice": {
        "Destinations": {
          "destination1": {
            "Address": "http://movies-service:8081"
          }
        }
      },
      "monolith": {
        "Destinations": {
          "destination1": {
            "Address": "http://monolith:8080"
          }
        }
      }
    }
  },
  "MOVIES_MIGRATION_PERCENT": 50,
  "AllowedHosts": "*"
}
